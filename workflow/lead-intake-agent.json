      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Lead normalisieren').item.json;\nconst roh = $input.item.json.output?.[0]?.content?.[0]?.text;\n\nlet ki = roh;\nif (typeof roh === \"string\") {\n  try {\n    ki = JSON.parse(roh);\n  } catch (e) {\n    ki = null;\n  }\n}\n\nconst erlaubt = [\"hot\", \"warm\", \"cold\", \"spam\"];\nconst gueltig = ki !== null && typeof ki === \"object\" && erlaubt.includes(ki.kategorie);\n\nreturn {\n  json: {\n    ...lead,\n    kategorie: gueltig ? ki.kategorie : \"manuell_pruefen\",\n    score: gueltig ? ki.score : null,\n    begruendung: gueltig ? ki.begruendung : \"KI-Antwort war ungültig\"\n  }\n};"
      },
