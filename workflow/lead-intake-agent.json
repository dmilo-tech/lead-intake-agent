      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const fields = $input.item.json.body?.data?.fields ?? [];\n\nfunction wert(label) {\n  const f = fields.find(f => f.label === label);\n  if (!f || f.value == null) return \"\";\n  if (Array.isArray(f.value) && f.options) {\n    return f.options\n      .filter(o => f.value.includes(o.id))\n      .map(o => o.text)\n      .join(\", \");\n  }\n  return String(f.value).trim();\n}\n\nreturn {\n  json: {\n    name: wert(\"Name\"),\n    email: wert(\"E-Mail\").toLowerCase(),\n    firma: wert(\"Firma\"),\n    branche: wert(\"Branche\"),\n    budget: wert(\"Budget\"),\n    anliegen: wert(\"Worum geht's?\"),\n    eingegangenAm: $input.item.json.body?.createdAt ?? \"\"\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
