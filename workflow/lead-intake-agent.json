        "responses": {
          "values": [
            {
              "role": "system",
              "content": "Du bist ein Lead-Qualifizierer für eine KI-Automatisierungsagentur.\nAntworte ausschließlich mit JSON in diesem Format:\n{\"kategorie\": \"hot\" | \"warm\" | \"cold\" | \"spam\", \"score\": Zahl von 1 bis 10, \"begruendung\": \"maximal 2 Sätze\"}\n\nKriterien:\n- hot: Branche Coaching oder Agentur UND Budget ab 3.000 € UND ein konkretes Automatisierungsanliegen\n- warm: passendes Anliegen, aber Budget unter 3.000 € oder Anliegen noch unklar\n- cold: kein Bezug zu Automatisierung oder KI\n- spam: Werbung, Unsinn oder offensichtliche Testeinträge"
            },
            {
              "content": "=Name: {{ $json.name }}\nFirma: {{ $json.firma }}\nBranche: {{ $json.branche }}\nBudget: {{ $json.budget }}\nAnliegen: {{ $json.anliegen }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_object",
              "verbosity": "low"
            }
          }
        }
      },
